<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@mipmap/splash"
    android:id="@+id/main"
    tools:context=".SplashActivity">

    <Button
        android:id="@+id/btn_login"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_width="@dimen/dimen_100dp"
        android:layout_height="@dimen/dimen_40dp"
        android:layout_marginStart="@dimen/dimen_43dp"
        android:layout_marginBottom="@dimen/dimen_90dp"
        android:text="@string/login"
        android:background="@drawable/splash_login_btn"
        android:textColor="#ffffff"
        android:textSize="@dimen/size_14sp"
        />
    <Button
        android:id="@+id/btn_register"
        android:layout_width="@dimen/dimen_100dp"
        android:layout_height="@dimen/dimen_40dp"
        android:text="@string/register"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/dimen_43dp"
        android:layout_marginBottom="@dimen/dimen_90dp"
        android:background="@drawable/splash_register_btn"
        android:textColor="#ffffff"
        android:textSize="@dimen/size_14sp"
        />

</RelativeLayout>